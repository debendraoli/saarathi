# Local dev environment for the Saarathi backend. Copy to `.env` and adjust.
# Never commit real secrets. Production config comes from the in-country host.
# Generate a JWT secret with: openssl rand -hex 32
#
# Two ways to run the backend:
#   1. Full stack in containers (easiest):  docker compose up -d --build
#      Builds every service image and starts infra + services + gateway. The
#      compose file supplies each service's env (service-to-service uses the
#      compose DNS names postgres/redis/nats), so this .env is only read for the
#      few interpolated overrides below (JWT_SECRET, RUST_LOG, …).
#   2. Infra in containers, services on the host (cargo run): the services read
#      THIS file via dotenv, and reach infra on localhost (values below).
#
# Clients talk to ONE front door — the API gateway (Traefik) at
# http://localhost:8080 (dashboard :8090) — which routes by path to the services
# below. Only `routing` (8084) is internal.

# saarathi-auth
PORT=8081
RUST_LOG=info,saarathi_auth=debug

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://saarathi:saarathi_dev@localhost:5432/saarathi

# Auth
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_SECS=300
OTP_RATE_MAX=5
OTP_RATE_WINDOW_SECS=3600
# Dev mode logs + returns the OTP so you can test without an SMS gateway.
OTP_DEV_MODE=true

# KYC document storage (local dev; use in-country S3/MinIO in production)
KYC_STORAGE_DIR=./.data/kyc

# CORS + rate-limiting now live at the API gateway (backend/traefik/dynamic/
# routes.yml), not the services. Edit the allowed origins there.

# Dev-only: seed a super-admin so the dashboard can be logged into.
SEED_DEV_ADMIN_PHONE=+9779800000000

# ── saarathi-rides ──────────────────────────────────────────────────────────
RIDES_PORT=8082
# Fare distance/duration is measured by the saarathi-routing service. Blank =
# rides uses its local haversine fallback (offline-safe). Point it at the service:
#   ROUTING_SERVICE_URL=http://localhost:8084
ROUTING_SERVICE_URL=
# Local haversine fallback tuning (also used by the routing service).
ROUTING_ROAD_FACTOR=1.3
ROUTING_AVG_SPEED_KMH=22
FARE_TWO_WHEELER_PER_KM=20
FARE_FOUR_WHEELER_PER_KM=45
FARE_COMMISSION_RATE=0.10
# Dispatch (E5): driver geo-index lives in Redis; offers are sequential.
DISPATCH_OFFER_TTL_SECS=15
DISPATCH_RADIUS_KM=2
DISPATCH_MAX_RADIUS_KM=8
DISPATCH_PRESENCE_TTL_SECS=60

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# ── saarathi-notify ─────────────────────────────────────────────────────────
# Consumes NotifyRequest off NATS, owns the in-app inbox + push/SMS escalation.
NOTIFY_PORT=8083

# ── saarathi-routing ────────────────────────────────────────────────────────
# Wraps a self-hosted Valhalla (default) / OSRM engine; haversine fallback when
# the upstream is unreachable. Set ROUTING_URL to the engine (blank = haversine).
# To use the bundled Valhalla: docker compose --profile routing up -d valhalla
#   ROUTING_URL=http://localhost:8002
ROUTING_PORT=8084
ROUTING_URL=
ROUTING_ENGINE=valhalla
# Redis route cache: identical origin/dest pairs reuse the engine result.
ROUTE_CACHE_TTL_SECS=3600

# ── saarathi-payments ───────────────────────────────────────────────────────
# Payment operations (top-ups, payouts, PSP callbacks). Shares the DB with rides.
PAYMENTS_PORT=8085

# ── saarathi-campaigns ──────────────────────────────────────────────────────
# Campaign management (staff CRUD + preview). Shares the DB with rides.
CAMPAIGNS_PORT=8086

# ── saarathi-partners ───────────────────────────────────────────────────────
# Fleet/partner domain: governance, member/driver/rider roster, fleet money +
# dashboards + campaigns. Shares the DB (auth owns identity + partner DDL).
PARTNERS_PORT=8087

# ── Parcel delivery (rides service, trip_type='delivery') ───────────────────
# Config-driven delivery pricing (not bound by the ride per-km caps; doc 08 §5.2).
DELIVERY_BASE_FARE=30
DELIVERY_PER_KM=15
DELIVERY_TIER_SMALL_SURCHARGE=10
DELIVERY_TIER_MEDIUM_SURCHARGE=25
DELIVERY_FRAGILE_SURCHARGE=20

# ── WebRTC ICE (self-hosted Coturn) ─────────────────────────────────────────
# rides mints short-lived TURN credentials at GET /v1/rtc/ice from TURN_SECRET
# (Coturn `use-auth-secret`). Blank TURN_SECRET/TURN_URLS = public STUN only
# (fine for dev). Start Coturn: docker compose --profile comms up -d coturn
TURN_SECRET=
TURN_URLS=
TURN_STUN_URL=stun:stun.l.google.com:19302
