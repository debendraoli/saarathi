default_platform(:ios)

platform :ios do
  desc "Build (manual signing, cert/profile already imported by CI) and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Runner.ipa",
      export_options: {
        provisioningProfiles: {
          "com.saarathi.app" => ENV["IOS_PROVISIONING_PROFILE_SPECIFIER"],
        },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
        "PROVISIONING_PROFILE_SPECIFIER=\"#{ENV['IOS_PROVISIONING_PROFILE_SPECIFIER']}\" " \
        "CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
        "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Runner.ipa",
      skip_waiting_for_build_processing: true,
    )
  end
end
